# Keep LF line endings in every checkout, including Windows, so a release built here matches
# F-Droid's Linux build byte for byte (reproducible builds).
* text=auto eol=lf
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.ttf binary
*.otf binary
# Windows batch scripts keep CRLF; cmd.exe can misparse labels in LF files.
gradlew.bat text eol=crlf
*.bat text eol=crlf
