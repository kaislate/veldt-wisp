<?xml version="1.0" encoding="utf-8"?>
<!-- Merged over src/main only in the `github` flavor. Everything here serves the in-app
     updater, which F-Droid does not allow, so keeping it out of src/main is what makes
     the `fdroid` APK's manifest free of it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The updater hands the downloaded APK to the system package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Shares the downloaded update APK (in the cache dir, see res/xml/file_paths)
             with the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
